{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // 结构性防残余（清理轮）：未使用的局部变量/导入/函数一律报错。
    // 不开 noUnusedParameters——接口实现里「签名要求但用不到」的形参是合法的，
    // 为它们逐个加下划线是噪音而不是清理。
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["vite.config.ts", "renderer/src/**/*.ts", "renderer/src/**/*.d.ts"]
}
